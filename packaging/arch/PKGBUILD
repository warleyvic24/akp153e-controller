# Maintainer: warleyvic24
# Compila o repositório local (esta pasta fica em packaging/arch). Uso: cd packaging/arch && makepkg -si
pkgname=keyforge
pkgver=0.1.0
pkgrel=1
pkgdesc="Keyforge: software livre para stream controllers (AJAZZ AKP153E e outros)"
# O pacote antigo tinha outro nome: este o substitui (binário, atalho e regra udev).
replaces=('akp153e')
conflicts=('akp153e')
provides=('akp153e')
arch=('x86_64')
license=('MIT')
depends=('gtk3' 'libayatana-appindicator' 'systemd-libs' 'libxkbcommon' 'libpulse' 'ttf-dejavu')
makedepends=('cargo' 'pkgconf')
optdepends=('hyprland: foco do editor pelo hyprctl'
            'wmctrl: foco do editor no X11'
            'xorg-xprop: perfil automático no X11')
options=('!lto')
install=keyforge.install

_root="$startdir/../.."

build() {
  cd "$_root"
  cargo build --release --locked --target-dir "$srcdir/target"
}

package() {
  cd "$_root"
  install -Dm755 "$srcdir/target/release/keyforge" "$pkgdir/usr/bin/keyforge"
  install -Dm644 packaging/linux/70-keyforge.rules "$pkgdir/usr/lib/udev/rules.d/70-keyforge.rules"
  install -Dm644 packaging/linux/keyforge.desktop "$pkgdir/usr/share/applications/keyforge.desktop"
}
