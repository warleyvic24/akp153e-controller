# Permite que o usuário logado acesse o AJAZZ AKP153E sem ser root.
# O número precisa ser menor que 73: o `uaccess` só vale se a marca chegar antes do 73-seat-late.rules do systemd.
# Instalar em /etc/udev/rules.d/ e recarregar: sudo udevadm control --reload && sudo udevadm trigger
# power/control="on" desliga a suspensão automática do USB só para o aparelho: suspenso, ele
# pode não acordar a tempo e o kernel o derruba e o reconecta, apagando as teclas.
# Os pares VID/PID são os de `usb::IDS` (src/usb/mod.rs); um teste confere que não saíram de sincronia.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0300", ATTRS{idProduct}=="3010", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="6677", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6602", ATTRS{idProduct}=="1001", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0300", ATTRS{idProduct}=="3010", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="6677", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="6602", ATTRS{idProduct}=="1001", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0300", ATTR{idProduct}=="3010", ATTR{power/control}="on"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="33c3", ATTR{idProduct}=="6677", ATTR{power/control}="on"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="6602", ATTR{idProduct}=="1001", ATTR{power/control}="on"
